# Groq — Agent 01 CV vision
GROQ_API_KEY=your_groq_api_key_here

# Typhoon v2 (SCB10X) 
TYPHOON_API_KEY=your_typhoon_api_key_here
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v2-70b-instruct

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1
S3_BUCKET=assetwitness-cases

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# LangSmith observability (optional — remove to disable tracing)
# Get your key at https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=assetwitness
